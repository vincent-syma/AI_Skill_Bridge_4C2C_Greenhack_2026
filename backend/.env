# Copy to .env and adjust before any non-local deployment.
# Never commit your real .env file.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://bridge:bridge@localhost:5432/bridge

# ── JWT / auth ────────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production-please-32b+
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie ────────────────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false          # set true in production (HTTPS)
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
# Add your public tunnel URL as needed for browser access via Cloudflare Tunnel
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5500","https://tree-ebook-hip-sin.trycloudflare.com","https://ink-wife-toronto-log.trycloudflare.com"]

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_ACCESS=false

# ── File uploads ──────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Seed defaults ─────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@bridge.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_POWER_EMAIL=poweruser@bridge.local
SEED_POWER_PASSWORD=Power1234!
SEED_DEMO_EMAIL=jana.novakova@firma.cz
SEED_DEMO_PASSWORD=Demo1234!
